{
    "city": "{{ city }}",
    "country": "{{ country }}",
    "measurements": [
        {% for m in measurements %}
        {
            "date": "{{ m.date|date('Y-m-d') }}",
            "celsius": "{{ m.celsius }}",
            "fahrenheit": "{{ m.fahrenheit }}"
        }{{ loop.last ? '' : ',' }}
        {% endfor %}
    ]
}
